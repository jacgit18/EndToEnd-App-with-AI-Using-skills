# Production Caddyfile (used by compose.prod.yaml; the dev stack keeps ./Caddyfile).
#
# Traffic path:  browser --HTTPS--> Cloudflare --tunnel--> cloudflared --HTTP--> this Caddy
#                                                                            --> backend / static files
# TLS ends at Cloudflare's edge, so Caddy speaks plain HTTP here and ":80" is
# right — Caddy only requests certificates when it's given a real domain name.
#
# ── If you were serious about this (paid / sturdier alternatives) ─────────────
#  * Domain: buy one (~$10-12/yr from Cloudflare Registrar, Porkbun, Namecheap)
#    instead of a random *.trycloudflare.com hostname that changes on restart.
#    With a domain on Cloudflare you can run a *named* tunnel (still free) with
#    a stable URL — or drop the tunnel, point an A record at a VPS, replace
#    ":80" below with "your.domain", and Caddy issues + renews a Let's Encrypt
#    certificate by itself (that was ADR-0012's original design).
#  * Host: a ~$5-7/mo VPS (Hetzner, DigitalOcean) so the app is up when your
#    laptop is off. This file stays the same; only the "how does traffic reach
#    Caddy" part changes.
# ──────────────────────────────────────────────────────────────────────────────

{
	# Trust X-Forwarded-For only from private ranges (cloudflared reaches Caddy
	# over the Compose network). Caddy then passes the real visitor IP through
	# to the backend instead of cloudflared's address — without this, the login
	# rate limiter would put every visitor in one bucket.
	servers {
		trusted_proxies static private_ranges
	}
}

:80 {
	# Request body caps, enforced here before the app sees a byte (FastAPI/Starlette parse a
	# multipart upload to a temp file BEFORE the handler's own 2 MB check runs; 2026-10-13
	# audit). CSV import: 2 MB file + multipart overhead. Every other API call is small JSON.
	handle /api/imports* {
		request_body {
			max_size 3MB
		}
		reverse_proxy backend:8000
	}
	handle /api/* {
		request_body {
			max_size 64KB
		}
		reverse_proxy backend:8000
	}
	handle /health {
		reverse_proxy backend:8000
	}

	# Compress text responses (JS/CSS/HTML/JSON); without this the 290 kB bundle
	# ships raw. Found by Lighthouse (uses-text-compression), 2026-10-03.
	encode zstd gzip

	# Vite fingerprints everything under /assets/ (the hash changes with the
	# content), so it can be cached for a year. index.html is never fingerprinted
	# and keeps Caddy's default (revalidate every time).
	@assets path /assets/*
	header @assets Cache-Control "public, max-age=31536000, immutable"

	# Everything else is the built React app (frontend/Dockerfile.prod copies the
	# Vite build into /srv). try_files makes client-side routes like /login fall
	# back to index.html instead of a 404 on refresh.
	handle {
		root * /srv
		try_files {path} /index.html
		file_server
	}

	# Cheap hardening; the app is same-origin so none of these break it.
	#  * CSP: the built app is one external module script plus an inline <style> in
	#    index.html, React inline style="" attributes and same-origin /api calls. So scripts
	#    are 'self' only (no inline script, no eval); styles need 'unsafe-inline' for those
	#    attributes; connect/img are same-origin (img also data: for inline SVG); nothing may
	#    frame the app, change <base>, post a form elsewhere or load plugins.
	#  * HSTS: Cloudflare terminates TLS, so browsers only ever reach the site over HTTPS;
	#    one year, no includeSubDomains/preload (the domain is a free DNSHE one).
	header {
		X-Content-Type-Options nosniff
		X-Frame-Options DENY
		Referrer-Policy same-origin
		Content-Security-Policy "default-src 'self'; script-src 'self'; style-src 'self' 'unsafe-inline'; img-src 'self' data:; connect-src 'self'; object-src 'none'; base-uri 'none'; form-action 'self'; frame-ancestors 'none'"
		Strict-Transport-Security "max-age=31536000"
		-Server
	}
}
