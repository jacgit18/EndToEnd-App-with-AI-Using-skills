# Read by compose.yaml for the Postgres container's credentials. Copy to
# .env (gitignored) and change the values if you want, or leave unset —
# compose.yaml's ${VAR:-default} syntax falls back to these same defaults
# either way, so this file is documentation more than a requirement.
#
# The auth secrets (AUTH_EMAIL, AUTH_PASSWORD_HASH, SESSION_SECRET) are NOT
# here — they don't go through Compose's ${VAR} interpolation at all (an
# argon2 hash's "$"-delimited format breaks that mechanism). See
# backend/.env.docker.example instead.
POSTGRES_USER=finance
POSTGRES_PASSWORD=finance
POSTGRES_DB=finance
