DATABASE_URL=postgresql+psycopg://finance:finance@localhost:5432/finance
ENV=dev

# Generate real values for the hash and secret, per-machine — never copy the
# ones below, they're illustrative only, not usable credentials:
#   uv run python -c "from argon2 import PasswordHasher; print(PasswordHasher().hash('yourpassword'))"
#   uv run python -c "import secrets; print(secrets.token_urlsafe(32))"
AUTH_EMAIL=owner@example.com
AUTH_PASSWORD_HASH=$argon2id$v=19$m=65536,t=3,p=4$examplesaltvalue$exampleoutputhashvalue
SESSION_SECRET=replace-with-a-generated-token-urlsafe-32-value
