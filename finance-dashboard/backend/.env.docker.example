# Loaded by compose.yaml's backend service via `env_file:`. Copy this file
# to backend/.env.docker (gitignored) with real values.
#
# IMPORTANT: double every literal "$" as "$$". Confirmed live (not just from
# docs): Compose's ${VAR} interpolation pass applies to env_file values too,
# not just compose.yaml's own text — an unescaped argon2 hash here gets
# silently mangled ("$argon2id$v=19..." loses each "$word" segment, treated
# as an undefined variable reference and stripped). "$$" is Compose's own
# documented escape for a literal "$". This file needs it; backend/.env
# (used for the native, non-Compose run) does NOT — pydantic-settings' own
# .env loading is plain literal parsing, unrelated to Compose's mechanism,
# so that file keeps single "$" signs as-is.
#
# Generate real values, per-machine — never copy the ones below, they're
# illustrative only, not usable credentials. Double the "$" in the hash
# argon2 gives you before pasting it here:
#   uv run python -c "from argon2 import PasswordHasher; print(PasswordHasher().hash('yourpassword'))"
#   uv run python -c "import secrets; print(secrets.token_urlsafe(32))"
AUTH_EMAIL=owner@example.com
AUTH_PASSWORD_HASH=$$argon2id$$v=19$$m=65536,t=3,p=4$$examplesaltvalue$$exampleoutputhashvalue
SESSION_SECRET=replace-with-a-generated-token-urlsafe-32-value
